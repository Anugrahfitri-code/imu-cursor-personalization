# Default text handling
* text=auto

# Source code
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.properties text eol=lf

# Shell scripts
*.sh text eol=lf
gradlew text eol=lf

# Windows scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Research data
*.csv text eol=lf
*.txt text eol=lf

# Binary
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.apk binary